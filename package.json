{
  "name": "obsidian-context-mcp",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm test && npm run build",
    "deploy": "node scripts/deploy.mjs",
    "mcp": "node dist/mcp.cjs",
    "package": "node scripts/package.mjs",
    "rollback": "node scripts/rollback.mjs",
    "tunnel:start": "node scripts/tunnel.mjs start",
    "tunnel:manual": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/manual-start-mcp.ps1",
    "tunnel:restart": "node scripts/tunnel.mjs restart",
    "tunnel:status": "node scripts/tunnel.mjs status",
    "tunnel:stop": "node scripts/tunnel.mjs stop",
    "tunnel:shortcut": "powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -File scripts/tunnel-startup.ps1 -Mode Shortcut",
    "tunnel:autostart:install": "powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -File scripts/tunnel-startup.ps1 -Mode Install",
    "tunnel:autostart:status": "powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -File scripts/tunnel-startup.ps1 -Mode Status",
    "tunnel:autostart:uninstall": "powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -File scripts/tunnel-startup.ps1 -Mode Uninstall",
    "setup": "node scripts/deploy.mjs",
    "doctor": "node scripts/doctor.mjs",
    "tools": "node dist/call.cjs list",
    "context": "node dist/call.cjs obsidian_get_context",
    "tunnel:configure": "node scripts/configure-tunnel.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@lezer/markdown": "^1.6.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "diff": "^8.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.5",
    "fflate": "^0.8.3",
    "obsidian": "1.13.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
